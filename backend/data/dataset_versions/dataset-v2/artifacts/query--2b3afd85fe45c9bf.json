":true,\"allowProfileParsing\":true},\"relevantServicesCount\":2,\"occupations\":[{\"id\":\"bca09de6-d110-4a7d-93ea-848b0334f165\",\"rubricId\":\"\\u002Fremont-i-stroitel_stvo\",\"attrs\":{\"experience\":11,\"workingDays\":[\"monday\",\"wednesday\",\"thursday\",\"tuesday\",\"friday\",\"sunday\",\"saturday\"],\"workStartTime\":8,\"workFinishTime\":23},\"name\":\"Ремонт и строительство\",\"numberId\":1344,\"seoId\":\"\\u002Fremont-i-stroitelstvo\",\"specializations\":[{\"id\":\"0d38ab62-1a8c-42c8-8cb7-b21c73720b88\",\"rubricId\":\"\\u002Fremont-i-stroitel_stvo\\u002Fremont-kvartir-i-domov\",\"attrs\":{\"experience\":11,\"isAbleToDeparture\":true,\"workingDays\":[\"monday\",\"tuesday\",\"wednesday\",\"thursday\",\"friday\",\"saturday\",\"sunday\"],\"workStartTime\":8,\"workFinishTime\":23,\"description\":\"Ремонт квартир и домов — это комплекс мероприятий, направленных на обновление, реконструкцию или улучшение жилых и коммерческих помещений. Он включает в себя множество этапов: от составления дизайн-проекта до выбора материалов и выполнения строительных работ. Основные виды ремонта включают косметический, капитальный и плановый, каждый из которых имеет свои особенности и требования.\\n\\nКосметический ремонт предполагает обновление внешнего вида помещения — покраску стен, замену напольных покрытий, установку новых дверей и элементов декора. Такой ремонт обычно менее затратный и занимает меньше времени.  \\nКапитальный ремонт включает полное восстановление или замену систем коммуникаций, демонтаж старых конструкций, выравнивание стен и потолков, замену окон и дверей. Это более сложный и обширный процесс, требующий участия специалистов.  \\nПлановый ремонт осуществляется для поддержания помещений в хорошем состоянии, устранения износа и предотвращения серьезных повреждений.\\n\\nПри выборе подрядчика важно учитывать его опыт, репутацию и качество выполненных работ. Правильное планирование, использование современных материалов и технологий позволяют добиться долговечности и эстетики в результате.\",\"features\":{\"brigada\":true,\"contract\":true,\"remont_live\":[\"remont_live_2\"],\"warranty\":true}},\"occupationId\":\"\\u002Fremont-i-stroitel_stvo\",\"name\":\"Ремонт квартир и домов\",\"numberId\":1816,\"seoId\":\"\\u002Fremont-i-stroitelstvo\\u002Fremont-kvartir-i-domov\",\"specialistName\":\"Мастер по ремонту\",\"isPhotoSpecialization\":true,\"services\":[{\"id\":\"0e5490bc-732b-4303-be63-c18f26dd647c\",\"rubricId\":\"\\u002Fremont-i-stroitel_stvo\\u002Fremont-kvartir-i-domov\\u002Fkapital_nyj-remont-kvartiry\",\"specializationId\":\"\\u002Fremont-i-stroitel_stvo\\u002Fremont-kvartir-i-domov\",\"attrs\":{\"name\":\"Капитальный ремонт квартиры\",\"price\":500,\"priceMeasure\":\"service\",\"isMinimalPrice\":true,\"violations\":{}},\"parentId\":\"\\u002Fremont-i-stroitel_stvo\\u002Fremont-kvartir-i-domov\",\"name\":\"Капитальный ремонт квартиры\",\"numberId\":1818,\"seoId\":\"\\u002Fremont-i-stroitelstvo\\u002Fremont-kvartir-i-domov\\u002Fkapitalnyij-remont-kvartiryi\"},{\"id\":\"72a161e7-75c0-4e04-ad6f-11e151895f2f\",\"rubricId\":\"\\u002Fremont-i-stroitel_stvo\\u002Fremont-kvartir-i-domov\\u002Fkosmeticeskij-remont-kvartiry\",\"specializationId\":\"\\u002Fremont-i-stroitel_stvo\\u002Fremont-kvartir-i-domov\",\"attrs\":{\"name\":\"Косметический ремонт квартиры\",\"price\":500,\"priceMeasure\":\"service\",\"isMinimalPrice\":true,\"violations\":{}},\"parentId\":\"\\u002Fremont-i-stroitel_stvo\\u002Fremont-kvartir-i-domov\",\"name\":\"Косметический ремонт квартиры\",\"numberId\":1820,\"seoId\":\"\\u002Fremont-i-stroitelstvo\\u002Fremont-kvartir-i-domov\\u002Fkosmeticheskij-remont-kvartiryi\"},{\"id\":\"65b12360-8b6b-4a96-a8ab-23fbdb6e2476\",\"rubricId\":\"\\u002Fremont-i-stroitel_stvo\\u002Fremont-kvartir-i-domov\\u002Fkosmeticeskij-remont-doma\",\"specializationId\":\"\\u002Fremont-i-stroitel_stvo\\u002Fremont-kvartir-i-domov\",\"attrs\":{\"name\":\"Косметический ремонт дома\",\"price\":500,\"priceMeasure\":\"service\",\"isMinimalP