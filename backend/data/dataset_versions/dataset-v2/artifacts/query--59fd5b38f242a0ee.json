ные потолки в квартирах, домах и коммерческих помещениях.\\n\\nНапишите или позвоните — рассчитаю стоимость за 15 минут и скажу, сколько будет стоить именно ваш потолок.\",\"avatar\":\"https:\\u002F\\u002Favatars.mds.yandex.net:443\\u002Fget-ydo\\u002F15074467\\u002F2a0000019dba68a6f303913e511d1992dee5\",\"dob\":\"1977-08-09\",\"gender\":\"male\",\"education\":[],\"socialLinks\":{\"messengers\":{\"whatsapp\":\"+79163091256\",\"telegram\":\"https:\\u002F\\u002Ft.me\\u002FPotolokotprof\"},\"appointments\":{},\"other\":{}},\"firstName\":\"Николай\",\"lastName\":\"Т.\",\"displayName\":\"Николай Т.\",\"phoneId\":\"514750245\",\"addressesList\":[{\"address\":\"Москва, Краснодарская улица\",\"boundingBox\":[[37.742438,55.675265],[37.750649,55.679905]],\"isHouseHide\":false},{\"address\":\"Люберцы, Московская улица, 12\",\"boundingBox\":[[37.875039,55.670082],[37.883249,55.674722]],\"isHouseHide\":false},{\"address\":\"Люберцы, улица Лётчика Ларюшина, 6\",\"boundingBox\":[[37.861797,55.673641],[37.870008,55.67828]],\"isHouseHide\":false}],\"areasList\":[{\"name\":\"Люберцы\",\"LonLat\":[37.893328,55.676748],\"geoids\":[10738],\"is_point\":false,\"uri\":\"ymapsbm1:\\u002F\\u002Fgeo?data=Cgg1MzA2MzUxNBJB0KDQvtGB0YHQuNGPLCDQnNC-0YHQutC-0LLRgdC60LDRjyDQvtCx0LvQsNGB0YLRjCwg0JvRjtCx0LXRgNGG0YsiCg3FkhdCFf20XkI,\",\"name_components\":[{\"kind\":\"country\",\"name\":\"Россия\"},{\"kind\":\"province\",\"name\":\"Центральный федеральный округ\"},{\"kind\":\"province\",\"name\":\"Московская область\"},{\"kind\":\"area\",\"name\":\"городской округ Люберцы\"},{\"kind\":\"locality\",\"name\":\"Люберцы\"}],\"bounding_box\":[[37.856201,55.636499],[37.976144,55.711371]],\"metro\":null},{\"name\":\"посёлок городского типа Октябрьский\",\"LonLat\":[37.973727,55.610982],\"geoids\":[105574],\"is_point\":false,\"uri\":\"ymapsbm1:\\u002F\\u002Fgeo?data=Cgg1MzA2MzQxMxKVAdCg0L7RgdGB0LjRjywg0JzQvtGB0LrQvtCy0YHQutCw0Y8g0L7QsdC70LDRgdGC0YwsINCz0L7RgNC-0LTRgdC60L7QuSDQvtC60YDRg9CzINCb0Y7QsdC10YDRhtGLLCD